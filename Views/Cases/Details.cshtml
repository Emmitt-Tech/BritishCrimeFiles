@model UKCrimeWeb.Models.CaseDetailsViewModel

@{
    ViewData["Title"] = Model.Case?.Title ?? "Case Details";
}


<style>
    .timeline-popup {
        display: none;
    }

    .timeline-row:hover .timeline-popup {
        display: block;
    }
</style>

<style>
    .case-timeline-section {
        margin-top: 3rem;
    }

    .case-timeline-section h2 {
        margin-bottom: 1.5rem;
    }

    .case-timeline {
        position: relative;
        max-width: 900px;
        padding-left: 56px;
    }

    .case-timeline::before {
        content: "";
        position: absolute;
        left: 16px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #bdbdbd;
    }

    .case-timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .case-timeline-dot {
        position: absolute;
        left: 9px;
        top: 6px;
        width: 14px;
        height: 14px;
        background: #fff;
        border: 3px solid #222;
        border-radius: 50%;
        box-sizing: border-box;
        z-index: 2;
    }

    .case-timeline-main {
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 1rem;
        align-items: start;
    }

    .case-timeline-date {
        font-weight: 600;
        color: #666;
        line-height: 1.4;
        white-space: nowrap;
    }

    .case-timeline-body {
        position: relative;
        min-width: 0;
    }

    .case-timeline-title {
        font-weight: 600;
        color: #111;
        line-height: 1.4;
    }

    .case-timeline-popup {
        display: none;
        margin-top: 0.5rem;
        max-width: 550px;
        padding: 0.85rem 1rem;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .case-timeline-popup p {
        margin: 0;
        line-height: 1.5;
    }

    .case-timeline-item:hover .case-timeline-popup {
        display: block;
    }

    .case-timeline-horizontal {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        padding: 1rem 0 1.5rem 0;
        position: relative;
        scrollbar-width: none;
    }

    .case-timeline-horizontal::-webkit-scrollbar {
        display: none;
    }

    .case-timeline-horizontal-item::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 7px;
        width: calc(100% + 2rem);
        height: 3px;
        background: #bdbdbd;
        z-index: 0;
    }

    .case-timeline-horizontal-item:last-child::before {
        display: none;
    }

    .case-timeline-horizontal-item {
        flex: 0 0 240px;
        position: relative;
        z-index: 1;
    }

    .case-timeline-horizontal-dot {
        position: relative;
        z-index: 2;
        width: 14px;
        height: 14px;
        background: #fff;
        border: 3px solid #222;
        border-radius: 50%;
        box-sizing: border-box;
        margin-bottom: 0.75rem;
    }

    .case-timeline-carousel {
        position: relative;
    }

    .case-timeline-horizontal {
        flex: 1;
        min-width: 0;
    }

    .timeline-scroll-btn {
        position: absolute;
        top: 23px;
        transform: translateY(-50%);
        z-index: 5;

        border: none;
        background: white;
        width: 32px;
        height: 32px;
        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 2rem;
        line-height: 1;
        cursor: pointer;
        color: #666;
    }

    .timeline-scroll-left {
        left: -38px;
    }

    .timeline-scroll-right {
        right: -38px;
    }

    .timeline-scroll-btn:hover {
        color: #111;
    }
</style>

<style>
    .case-details-columns {
        display: block;
    }

    .case-left-column {
        position: static;
    }

    .case-right-column {
        min-width: 0;
    }

    /* keep your existing hover */
    .timeline-popup {
        display: none;
    }

    .timeline-row:hover .timeline-popup {
        display: block;
    }

    @@media (max-width: 900px) {
        .case-details-columns {
            grid-template-columns: 1fr;
        }

        .case-left-column {
            position: static;
        }
    }
</style>
<!-- END CSS -->

<!-- Hero banner -->
<div class="case-hero"
     style="background-image:url('@(string.IsNullOrWhiteSpace(Model.Case?.ImagePath) ? "/images/cases/saddleworth-moor.jpg" : Model.Case.ImagePath)')">

    <div class="case-hero-overlay">
        <h1>@Model.Case?.Title</h1>

        <p class="case-subtitle">
            @Model.Case?.Location
            @if (Model.Case?.YearStarted != null || Model.Case?.YearEnded != null)
            {
                <span> • </span>
                <span>@Model.Case?.YearStarted</span>

                @if (Model.Case?.YearStarted != null && Model.Case?.YearEnded != null)
                {
                    <span>–</span>
                }
                <span>@Model.Case?.YearEnded</span>
            }
        </p>

    </div>
</div>

<div class="case-facts-grid">
    @if (!string.IsNullOrWhiteSpace(Model.Case?.Location))
    {
        <div class="fact-item">
            <div class="fact-label">Location</div>
            <div class="fact-value">@Model.Case.Location</div>
        </div>
    }

    @if (Model.Case?.VictimCount != null)
    {
        <div class="fact-item">
            <div class="fact-label">Victims</div>
            <div class="fact-value">@Model.Case.VictimCount</div>
        </div>
    }

    @if (Model.Case?.YearStarted != null || Model.Case?.YearEnded != null)
    {
        <div class="fact-item">
            <div class="fact-label">Years active</div>
            <div class="fact-value">
                @if (Model.Case?.YearStarted != null && Model.Case?.YearEnded != null)
                {
                    @($"{Model.Case.YearStarted} - {Model.Case.YearEnded}")
                }
                else if (Model.Case?.YearStarted != null)
                {
                    @($"{Model.Case.YearStarted} -")
                }
                else
                {
                    @($"- {Model.Case?.YearEnded}")
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Case.Sentence))
    {
        <div class="fact-item">
            <div class="fact-label">Sentence</div>
            <div class="fact-value">@Model.Case.Sentence</div>
        </div>
    }

</div>

<!-- Key facts section -->
<div class="person-page">
    <div class="case-details-columns">

  
        <!-- Timeline section -->
        <section style="margin-top: 3rem;">
            <h2 style="margin-bottom: 1.5rem;">Timeline</h2>

            <div class="case-timeline-carousel">

                <button type="button" class="timeline-scroll-btn timeline-scroll-left"
                        aria-label="Scroll timeline left">
                    ‹
                </button>

                <div class="case-timeline-horizontal">

                    @foreach (var item in Model.TimelineEvents)
                    {
                        <div class="timeline-row case-timeline-horizontal-item">
                            <div class="case-timeline-horizontal-dot"></div>
                            <div style="display: grid; grid-template-columns: 82px 1fr; gap: 0.5rem; align-items: start;">
                                <div style="font-weight: 600; color: #666; line-height: 1.4; white-space: nowrap;">
                                    @(string.IsNullOrWhiteSpace(item.DisplayDate)
                                        ? item.EventDate?.ToString("dd MMM yyyy")
                                        : item.DisplayDate)
                                </div>

                                <div>
                                    <div style="font-weight: 600; color: #111; line-height: 1.4;">
                                        @item.Title
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <!-- Timeline description block-->
                                        <div class="timeline-popup"
                                             style="margin-top: 0.5rem; max-width: 550px; padding: 0.85rem 1rem; background: #fff; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                            <p style="margin: 0; line-height: 1.5;">@item.Description</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="timeline-scroll-btn timeline-scroll-right"
                        aria-label="Scroll timeline right">
                    ›
                </button>

            </div>

        </section>

        <div class="case-right-column">
            @if (!string.IsNullOrWhiteSpace(Model.Case?.Summary))
            {
                <div class="section-card">
                    <div class="case-key-facts-layout">
                        <div class="case-key-facts">

                            
                        </div>
                    </div>

                    <h2>Overview</h2>

                    <!-- Overview  - short -->
                    @if (!string.IsNullOrWhiteSpace(Model.Case?.Summary))
                    {
                        <div class="case-overview">
                            @Model.Case.Summary
                        </div>
                    }

                    <!-- Overview - long -->
                    @if (!string.IsNullOrWhiteSpace(Model.Case?.SummaryFull))
                    {
                        <details class="case-overview-full">
                            <summary class="overview-toggle">
                                <span class="overview-toggle-text">Continue reading</span>
                            </summary>

                            <div class="case-overview-expanded">
                                @Model.Case.SummaryFull
                            </div>
                        </details>
                    }
                </div>
            }


            <!--People -->
            <div class="section-card">
                @{
                    var offenders = Model.CasePeople
                        .Where(cp => cp.Role == "Offender")
                        .ToList();

                    var victims = Model.CasePeople
                        .Where(cp => cp.Role == "Victim")
                        .OrderBy(cp => cp.SortOrder ?? int.MaxValue)
                        .ThenBy(cp => cp.Person!.LastName)
                        .ThenBy(cp => cp.Person!.FirstName)
                        .ToList();
                }

                @if (offenders.Any())
                {
                    <div class="people-group-heading">Offenders</div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="People" asp-action="Create" asp-route-caseId="@Model.Case?.CaseId"
                           asp-route-role="Offender" class="case-add-link">
                            Add offender
                        </a>
                    }
                    <div class="linked-people-grid">
                        @foreach (var casePerson in offenders)
                        {
                            var person = casePerson.Person!;
                            var displayName = $"{person.FirstName} {person.LastName}".Trim();

                            <a class="linked-person-card" asp-controller="People" asp-action="Details"
                               asp-route-id="@person.PersonId">

                                <div class="linked-person-image-wrap">

                                    <div class="linked-person-image-wrap">

                                        @if (!string.IsNullOrWhiteSpace(person.PhotoPath))
                                        {
                                            <img src="@person.PhotoPath" alt="@displayName" class="linked-person-photo" />
                                        }
                                        else
                                        {
                                            <div class="linked-person-photo no-photo-small">No photo</div>
                                        }

                                        <div class="linked-person-name-overlay">
                                            @displayName
                                        </div>

                                    </div>
                                </div>


                            </a>
                        }
                    </div>
                }

                <div class="people-group-heading">Victims</div>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="People" asp-action="Create" asp-route-caseId="@Model.Case?.CaseId"
                       asp-route-role="Victim" class="case-add-link">
                        Add victim
                    </a>
                }
                <div class="victim-carousel">
                    <button type="button" class="victim-scroll-btn victim-scroll-left" aria-label="Scroll victims left">
                        ‹
                    </button>

                    <div class="linked-people-grid victim-scroll-row" id="victimScrollRow">
                        @foreach (var casePerson in victims)
                        {
                            var person = casePerson.Person!;
                            var displayName = $"{person.FirstName} {person.LastName}".Trim();

                            <a class="linked-person-card" asp-controller="People" asp-action="Details"
                               asp-route-id="@person.PersonId">

                                <div class="linked-person-image-wrap">
                                    @if (!string.IsNullOrWhiteSpace(person.PhotoPath))
                                    {
                                        <img src="@person.PhotoPath" alt="@displayName" class="linked-person-photo" />
                                    }
                                    else
                                    {
                                        <div class="linked-person-photo no-photo-small">No photo</div>
                                    }

                                    <div class="linked-person-name-overlay">
                                        @displayName
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <button type="button" class="victim-scroll-btn victim-scroll-right"
                            aria-label="Scroll victims right">
                        ›
                    </button>
                </div>

                <!-- Books -->
                @if (Model.Books != null && Model.Books.Any())
                {
                    <hr class="section-divider" />

                    <section class="books-section">
                        <div class="books-header">
                            <h2>Books</h2>

                            <div class="books-hint">
                                <img src="/images/site/amazon-logo.png" alt="Amazon" class="amazon-logo-inline" />
                                <span>Order on Amazon</span>
                            </div>
                        </div>

                        <div class="books-row">
                            @foreach (var book in Model.Books)
                            {
                                <div class="book-card">
                                    @if (!string.IsNullOrWhiteSpace(book.ImageUrl))
                                    {
                                        @if (!string.IsNullOrWhiteSpace(book.PurchaseUrl))
                                        {
                                            <a href="@book.PurchaseUrl" target="_blank" rel="noopener noreferrer sponsored">
                                                <img src="@book.ImageUrl" alt="@book.Title" class="book-card-image" />
                                            </a>
                                        }
                                        else
                                        {
                                            <img src="@book.ImageUrl" alt="@book.Title" class="book-card-image" />
                                        }
                                    }

                                    <div class="book-card-title">
                                        @book.Title
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>


<p>
    <a asp-controller="Home" asp-action="Index">Back to home</a>
</p>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const row = document.getElementById("victimScrollRow");
        const leftButton = document.querySelector(".victim-scroll-left");
        const rightButton = document.querySelector(".victim-scroll-right");

        leftButton?.addEventListener("click", function () {
            row?.scrollBy({
                left: -240,
                behavior: "smooth"
            });
        });

        rightButton?.addEventListener("click", function () {
            row?.scrollBy({
                left: 240,
                behavior: "smooth"
            });
        });
    });

    const timeline = document.querySelector(".case-timeline-horizontal");
    const timelineLeft = document.querySelector(".timeline-scroll-left");
    const timelineRight = document.querySelector(".timeline-scroll-right");

    timelineLeft?.addEventListener("click", function () {
        timeline?.scrollBy({
            left: -300,
            behavior: "smooth"
        });
    });

    timelineRight?.addEventListener("click", function () {
        timeline?.scrollBy({
            left: 300,
            behavior: "smooth"
        });
    });
</script>