@model UKCrimeWeb.Models.TimelineEditorViewModel

@{
    ViewData["Title"] = $"Edit timeline - {Model.Case.Title}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="mb-1">Edit timeline</h1>
            <div class="text-muted">@Model.Case.Title</div>
        </div>
        <a asp-controller="Cases" asp-action="Details" asp-route-id="@Model.Case.CaseId" class="btn btn-outline-secondary">
            Back to case
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Add timeline entry</h2>

            <form asp-action="Create" method="post">
                <input type="hidden" name="caseId" value="@Model.Case.CaseId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="displayDate" class="form-label">Date</label>
                        <input id="displayDate" name="displayDate" value="@Model.NewEvent.DisplayDate" class="form-control" placeholder="e.g. 14 Dec 2021, Dec 2021, 2021" />
                        @if (ViewData.ModelState["displayDate"]?.Errors.Count > 0)
                        {
                            <div class="text-danger small mt-1">@ViewData.ModelState["displayDate"]!.Errors[0].ErrorMessage</div>
                        }
                    </div>

                    <div class="col-md-9">
                        <label for="title" class="form-label">Timeline entry</label>
                        <input id="title" name="title" value="@Model.NewEvent.Title" class="form-control" placeholder="Short title shown on the timeline" />
                        @if (ViewData.ModelState["title"]?.Errors.Count > 0)
                        {
                            <div class="text-danger small mt-1">@ViewData.ModelState["title"]!.Errors[0].ErrorMessage</div>
                        }
                    </div>

                    <div class="col-12">
                        <label for="description" class="form-label">Pop-up text <span class="text-muted">(optional)</span></label>
                        <textarea id="description" name="description" class="form-control" rows="4" placeholder="Leave blank if this entry does not need a pop-up">@Model.NewEvent.Description</textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3">Add entry</button>
            </form>
        </div>
    </div>

    <h2 class="h4 mb-3">Current timeline</h2>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-light border">No timeline entries yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 180px;">Date</th>
                        <th>Entry</th>
                        <th>Pop-up</th>
                        <th class="text-end" style="width: 190px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Events)
                    {
                        <tr>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(item.DisplayDate) ? item.EventDate?.ToString("dd MMM yyyy") : item.DisplayDate)</strong>
                            </td>
                            <td>@item.Title</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <span>@(item.Description.Length > 100 ? item.Description[..100] + "…" : item.Description)</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this timeline entry?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
