@model UKCrimeWeb.Models.TimelineEvent

@{
    ViewData["Title"] = "Edit timeline entry";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="mb-1">Edit timeline entry</h1>
            <div class="text-muted">@Model.Case?.Title</div>
        </div>
        <a asp-action="Index" asp-route-caseId="@Model.CaseId" class="btn btn-outline-secondary">Back to timeline</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="caseId" value="@Model.CaseId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="displayDate" class="form-label">Date</label>
            <input id="displayDate" name="displayDate" value="@Model.DisplayDate" class="form-control" placeholder="e.g. 14 Dec 2021, Dec 2021, 2021" />
            @if (ViewData.ModelState["displayDate"]?.Errors.Count > 0)
            {
                <div class="text-danger small mt-1">@ViewData.ModelState["displayDate"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <div class="mb-3">
            <label for="title" class="form-label">Timeline entry</label>
            <input id="title" name="title" value="@Model.Title" class="form-control" />
            @if (ViewData.ModelState["title"]?.Errors.Count > 0)
            {
                <div class="text-danger small mt-1">@ViewData.ModelState["title"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Pop-up text <span class="text-muted">(optional)</span></label>
            <textarea id="description" name="description" class="form-control" rows="6">@Model.Description</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save changes</button>
    </form>
</div>
