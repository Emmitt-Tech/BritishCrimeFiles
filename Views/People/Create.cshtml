@model UKCrimeWeb.Models.CreatePersonViewModel

@{
    ViewData["Title"] = "Create Person";
}

<h1>
    @if (Model.Role == "Victim")
    {
        <text>Add Victim</text>
    }
    else if (Model.Role == "Offender")
    {
        <text>Add Offender</text>
    }
    else
    {
        <text>Create Person</text>
    }

    @if (!string.IsNullOrWhiteSpace(Model.CaseTitle))
    {
        <text> — @Model.CaseTitle</text>
    }
</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="CaseId" class="form-label">Case</label>

        <select asp-for="CaseId" asp-items="Model.Cases" class="form-select">
            <option value="">Select a case...</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Role" class="form-label">Role</label>

        <select asp-for="Role" class="form-select">
            <option value="">Select a role...</option>
            <option value="Victim">Victim</option>
            <option value="Offender">Offender</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Nickname" class="form-label"></label>
        <input asp-for="Nickname" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SortOrder" class="form-label">Order</label>
        <input asp-for="SortOrder" class="form-control" type="number" min="1" />
    </div>

    <div class="mb-3">
        <label asp-for="Photo" class="form-label"></label>
        <input asp-for="Photo" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>
</form>