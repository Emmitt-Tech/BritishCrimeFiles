@model UKCrimeWeb.Models.EditPersonViewModel

@{
    ViewData["Title"] = "Edit Person";
}

<h1>Edit Person</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input asp-for="PersonId" type="hidden" />
    <input asp-for="ExistingPhotoPath" type="hidden" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Nickname" class="form-label"></label>
        <input asp-for="Nickname" class="form-control" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
    {
        <div class="mb-3">
            <div class="form-label">Current photo</div>

            <img src="@Model.ExistingPhotoPath" alt="@Model.FirstName @Model.LastName"
                 style="max-width: 220px; height: auto; border-radius: 8px;" />
        </div>
    }

    <div class="mb-3">
        <label asp-for="Photo" class="form-label">Replace / add photo</label>
        <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save changes
    </button>

</form>