@model IEnumerable<UKCrimeWeb.Models.Person>

@{
    ViewData["Title"] = "People";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">People</h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="People"
           asp-action="Create"
           class="btn btn-primary">
            Create person
        </a>
    }
</div>

@if (!Model.Any())
{
    <p>No people found.</p>
}
else
{
    <div class="linked-people-grid">
        @foreach (var p in Model)
        {
            <a asp-controller="People"
               asp-action="Details"
               asp-route-id="@p.PersonId"
               class="linked-person-card">

                <div class="linked-person-image-wrap">
                    @if (!string.IsNullOrWhiteSpace(p.PhotoPath))
                    {
                        <img src="@p.PhotoPath"
                             alt="@p.FirstName @p.LastName"
                             class="linked-person-photo" />
                    }
                    else
                    {
                        <div class="linked-person-photo no-photo-small">
                            No image
                        </div>
                    }

                    <div class="linked-person-name-overlay">
                        @p.FirstName @p.LastName
                    </div>
                </div>
            </a>
        }
    </div>
}