<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - British Crime Files</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ - British Crime Files.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <a asp-controller="Home" asp-action="Index" class="site-header-home-link"
           aria-label="British Crime Files"></a>
        <div class="site-header-inner">

            <a asp-controller="Cases" asp-action="Index" class="header-nav-link">
                Cases
            </a>

            <div class="header-search">
                <form asp-controller="Cases" asp-action="Index" method="get">
                    <input type="text" name="search" placeholder="Search cases..." />

                    <button type="submit">Search</button>
                </form>
            </div>
            <div class="header-login">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Emmitt-Tech - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
